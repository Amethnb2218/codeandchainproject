# SENTABAKH LITE — .env.example
# Copier en .env et renseigner les valeurs. Ne jamais commiter .env.
# Toutes les cles Bitnob restent cote serveur (server/).

# --- Bitnob (serveur uniquement) ---
# Obtenues sur https://bitnob.dev — l'environnement (sandbox/prod) depend du secret signe
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
BITNOB_WEBHOOK_SECRET=

# --- Backend ---
PORT=4000
DATABASE_URL=file:./data/sentabakh.db
JWT_SECRET=change-me-32-chars-minimum-for-jwt
APP_MODE=sandbox
# sandbox | demo | production — sandbox = appels reels en test, demo = simulation explicite, production = reel
CORS_ORIGIN=http://localhost:5173

# --- Frontend (Vite, prefixe VITE_ requis) ---
VITE_API_URL=http://localhost:4000
VITE_APP_MODE=sandbox

# --- Demo / securite ---
DEMO_LABEL=DEMONSTRATION — AUCUN FONDS REEL
