# SENTABAKH LITE — .env.example
# Copier en .env et renseigner les valeurs. Ne jamais commiter .env.
# Toutes les cles Bitnob restent cote serveur (server/).

# --- Bitnob (serveur uniquement) ---
# Obtenues sur https://bitnob.dev → app.bitnob.com > Settings > API Keys
# IMPORTANT: il faut LES DEUX champs — CLIENT_ID (UUID) + CLIENT_SECRET (avec son préfixe prd:, ex: prd:sandbox_...).
# Probe 18/10: seul "prd:sandbox_..." signe correctement (whoami 200), "sandbox_..." sans prd: = 401.
# Host unique https://api.bitnob.com — l'env sandbox/prod est choisi par le secret qui signe.
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
BITNOB_WEBHOOK_SECRET=
# Optionnel — si tu as un customer Bitnob (UUID), sinon le serveur omet customer_id (optionnel côté Lightning)
# BITNOB_CUSTOMER_ID=
# Optionnel — pour overrider le host (par défaut https://api.bitnob.com)
# BITNOB_BASE_URL=https://api.bitnob.com

# --- Backend ---
PORT=4000
DATABASE_URL=file:./data/sentabakh.db
JWT_SECRET=change-me-32-chars-minimum-for-jwt
APP_MODE=sandbox
# sandbox | demo | production — sandbox = appels reels en test, demo = simulation explicite, production = reel
CORS_ORIGIN=http://localhost:5173

# --- Frontend (Vite, prefixe VITE_ requis) ---
VITE_API_URL=http://localhost:4000
VITE_APP_MODE=sandbox

# --- Demo / securite ---
DEMO_LABEL=DEMONSTRATION — AUCUN FONDS REEL
